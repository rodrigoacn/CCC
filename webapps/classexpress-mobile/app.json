{
  "expo": {
    "name": "ClassExpress",
    "slug": "classexpress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "classexpress",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.classexpress.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ClassExpress necesita acceso a la cámara para videollamadas en clases.",
        "NSMicrophoneUsageDescription": "ClassExpress necesita acceso al micrófono para videollamadas en clases."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "package": "com.classexpress.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "react-native-webrtc",
        {
          "cameraPermission": "ClassExpress necesita acceso a la cámara para videollamadas en clases.",
          "microphonePermission": "ClassExpress necesita acceso al micrófono para videollamadas en clases."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
