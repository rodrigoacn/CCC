# ─────────────────────────────────────────────────────────────────────────────
#  .env.template — Environment configuration for ClassExpress
#  Copy to /var/www/classexpress/.env on each VM and fill in values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (VM4) ────────────────────────────────────────────────────────────
DB_HOST=VM4_IP
DB_PORT=3306
DB_NAME=classexpress
DB_USER=classexpress_app
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# ── Redis (VM4) ───────────────────────────────────────────────────────────────
REDIS_HOST=VM4_IP
REDIS_PORT=6379
REDIS_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD
REDIS_DB=0

# ── Storage ───────────────────────────────────────────────────────────────────
# Path where uploads/avatars are stored (use NFS mount for shared storage)
STORAGE_PATH=/var/www/classexpress/uploads
# Public URL for serving uploads (leave empty for auto-detect)
STORAGE_URL=

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=brevo
BREVO_API_KEY=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
EMAIL_FROM=noreply@classexpress.online
EMAIL_FROM_NAME=ClassExpress
EMAIL_DEV_MODE=false

# ── MercadoPago ───────────────────────────────────────────────────────────────
MP_PUBLIC_KEY=APP_USR-b10d1ed7-a254-488b-983a-c36f79f95412
MP_ACCESS_TOKEN=APP_USR-151981118092187-072618-5f45efad7a1c540ccbf24d70ade230af-3570251148
MP_MODE=production
# Optional shared secret for webhook signature verification
MP_WEBHOOK_SECRET=

# ── App ────────────────────────────────────────────────────────────────────────
# Go server listen port (nginx LB upstream must point here after cutover)
HTTP_PORT=8080
APP_URL=https://classexpress.online/CCC
APP_ENV=production

# ── Auth ───────────────────────────────────────────────────────────────────────
# Owner notifications email (used by retiros/admin flows)
APP_OWNER_EMAIL=
# Comma-separated IPs allowed to log in (empty = allow all)
LOGIN_ALLOWED_IPS=
# Email that may always access owner-only endpoints regardless of IP
LOGIN_OWNER_ACCESS_EMAIL=
